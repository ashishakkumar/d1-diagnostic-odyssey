# Local Postgres from `make db-up`. Synthetic rows only on a hosted database.
DATABASE_URL=postgresql://d1:d1@127.0.0.1:5432/d1

# Unset. A later extractor may read this for synthetic fixtures only.
GEMINI_API_KEY=

# Unset. The literature container is not part of this foundation.
NCBI_API_KEY=

# Empty unless this machine runs the experimental engine.
# That engine also needs engine/ACKNOWLEDGEMENT, which is gitignored.
D1_TRACK=
