{
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "additionalProperties": false,
        "description": "What a client may send to the gate. There is no reviewer field.",
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "draft_id": {
            "format": "uuid",
            "title": "Draft Id",
            "type": "string"
          },
          "seen_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Seen Hash",
            "type": "string"
          }
        },
        "required": [
          "draft_id",
          "decision",
          "seen_hash"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "ConfirmIn": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "format": "uuid",
            "title": "Case Id",
            "type": "string"
          },
          "terms": {
            "items": {
              "$ref": "#/components/schemas/ConfirmTermIn"
            },
            "title": "Terms",
            "type": "array"
          }
        },
        "required": [
          "case_id",
          "terms"
        ],
        "title": "ConfirmIn",
        "type": "object"
      },
      "ConfirmTermIn": {
        "additionalProperties": false,
        "properties": {
          "hpo_id": {
            "pattern": "^HP:[0-9]{7}$",
            "title": "Hpo Id",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "hpo_id",
          "label"
        ],
        "title": "ConfirmTermIn",
        "type": "object"
      },
      "DemoCaseOut": {
        "additionalProperties": false,
        "properties": {
          "blurb": {
            "title": "Blurb",
            "type": "string"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "case_id",
          "title",
          "blurb"
        ],
        "title": "DemoCaseOut",
        "type": "object"
      },
      "DemoListOut": {
        "additionalProperties": false,
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/components/schemas/DemoCaseOut"
            },
            "title": "Cases",
            "type": "array"
          }
        },
        "required": [
          "cases"
        ],
        "title": "DemoListOut",
        "type": "object"
      },
      "DemoLoadedOut": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "case_id"
        ],
        "title": "DemoLoadedOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PipelineIn": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          }
        },
        "title": "PipelineIn",
        "type": "object"
      },
      "PopulationPriorOut": {
        "additionalProperties": false,
        "properties": {
          "allele_frequency": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allele Frequency"
          },
          "experimental": {
            "title": "Experimental",
            "type": "boolean"
          },
          "found": {
            "title": "Found",
            "type": "boolean"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "limits": {
            "title": "Limits",
            "type": "string"
          },
          "opted_in": {
            "title": "Opted In",
            "type": "boolean"
          },
          "population": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Population"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "track": {
            "title": "Track",
            "type": "string"
          },
          "variant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "experimental",
          "track",
          "opted_in",
          "found",
          "label",
          "limits"
        ],
        "title": "PopulationPriorOut",
        "type": "object"
      },
      "ReliabilityPoint": {
        "additionalProperties": false,
        "description": "One point on a reliability curve. predicted and observed are both between 0 and 1.",
        "properties": {
          "observed": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Observed",
            "type": "number"
          },
          "predicted": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Predicted",
            "type": "number"
          }
        },
        "required": [
          "predicted",
          "observed"
        ],
        "title": "ReliabilityPoint",
        "type": "object"
      },
      "Report": {
        "additionalProperties": false,
        "description": "Catalogue comparison. A probability is valid only together with a reliability curve.",
        "properties": {
          "abstain_reason": {
            "anyOf": [
              {
                "enum": [
                  "many_within_factor",
                  "top_flips_between_bounds",
                  "tied_for_first",
                  "no_scoreable_disease"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstain Reason"
          },
          "abstained": {
            "title": "Abstained",
            "type": "boolean"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/TermEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "leading_orphanet_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leading Orphanet Id"
          },
          "margin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Margin"
          },
          "margin_fact": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the margin is not a finite number.",
            "title": "Margin Fact"
          },
          "margin_reason": {
            "anyOf": [
              {
                "const": "runner_up_ratio_is_zero",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The next disease ratio is 0, so the margin is not a finite number.",
            "title": "Margin Reason"
          },
          "probability": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "reliability_curve": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ReliabilityPoint"
                },
                "minItems": 2,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reliability Curve"
          }
        },
        "required": [
          "evidence",
          "margin",
          "abstained"
        ],
        "title": "Report",
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SessionBody",
        "type": "object"
      },
      "TermDraftBody": {
        "additionalProperties": false,
        "properties": {
          "hpo_id": {
            "pattern": "^HP:[0-9]{7}$",
            "title": "Hpo Id",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "presence": {
            "pattern": "^(present|excluded|uncertain)$",
            "title": "Presence",
            "type": "string"
          }
        },
        "required": [
          "hpo_id",
          "label",
          "presence"
        ],
        "title": "TermDraftBody",
        "type": "object"
      },
      "TermEvidence": {
        "additionalProperties": false,
        "description": "One accepted term against one cited frequency row.",
        "properties": {
          "background": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Background"
          },
          "hpo_id": {
            "pattern": "^HP:[0-9]{7}$",
            "title": "Hpo Id",
            "type": "string"
          },
          "lower_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lower Ratio"
          },
          "orphanet_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Orphanet Id"
          },
          "relation": {
            "enum": [
              "supports",
              "does_not_support"
            ],
            "title": "Relation",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "upper_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper Ratio"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "hpo_id",
          "relation",
          "source",
          "version"
        ],
        "title": "TermEvidence",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VariantBody": {
        "additionalProperties": false,
        "properties": {
          "gene_symbol": {
            "minLength": 1,
            "title": "Gene Symbol",
            "type": "string"
          },
          "lab_words": {
            "minLength": 1,
            "title": "Lab Words",
            "type": "string"
          },
          "report_date": {
            "format": "date",
            "title": "Report Date",
            "type": "string"
          },
          "variant": {
            "minLength": 1,
            "title": "Variant",
            "type": "string"
          }
        },
        "required": [
          "gene_symbol",
          "variant",
          "lab_words",
          "report_date"
        ],
        "title": "VariantBody",
        "type": "object"
      }
    }
  },
